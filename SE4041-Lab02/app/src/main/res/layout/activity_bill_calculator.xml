<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ceb_red"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/edtUnits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_units"
        android:importantForAutofill="no"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="@color/hint_white"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/ceb_yellow"
        android:text="@string/calculate"
        android:textColor="@color/ceb_dark_red"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvBill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/electricity_bill"
        android:textColor="@color/white"
        android:textSize="24sp" />
</LinearLayout>

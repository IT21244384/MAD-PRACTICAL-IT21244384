<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/edtNumber1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:hint="@string/enter_number_1"
        android:importantForAutofill="no"
        android:inputType="numberSigned|numberDecimal"
        android:minHeight="56dp"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/edtNumber2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/enter_number_2"
        android:importantForAutofill="no"
        android:inputType="numberSigned|numberDecimal"
        android:minHeight="56dp"
        android:textSize="20sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/btnAdd"
            style="@style/CalcButton"
            android:text="@string/op_add" />

        <Button
            android:id="@+id/btnSubtract"
            style="@style/CalcButton"
            android:text="@string/op_subtract" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalcButton"
            android:text="@string/op_multiply" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalcButton"
            android:text="@string/op_divide" />
    </GridLayout>
</LinearLayout>
